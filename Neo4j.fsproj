<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <PackageId>Alma.Neo4j</PackageId>
    <Version>7.0.0</Version>
    <RepositoryUrl>https://github.com/almacareer/prc-fneo4j.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/almacareer/prc-fneo4j</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/Utils.fs" />

    <Compile Include="src/Client.fs" />
    <Compile Include="src/Types.fs" />

    <Compile Include="src/CypherTypes.fs" />
    <Compile Include="src/CypherFluentQuery.fs" />
    <Compile Include="src/RawCypherQuery.fs" />
    <Compile Include="src/CypherQuery.fs" />

    <Compile Include="src/Dto.fs" />
  </ItemGroup>

  <Import Project=".paket\Paket.Restore.targets" />
</Project>
